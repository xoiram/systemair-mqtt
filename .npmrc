# Supply-chain hardening (see https://pnpm.io/settings)

# Don't resolve to a dependency version until it's been published for at
# least 7 days. Gives the ecosystem time to catch a compromised release
# before it can land here.
minimum-release-age=10080

# Before running a script (pnpm run/test/exec), verify node_modules still
# matches the lockfile and reinstall if it doesn't, instead of silently
# running against tampered dependencies.
verify-deps-before-run=install
