{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Oslo",
  "minimumReleaseAge": "7 days",
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "github-actions": {
    "pinDigests": true
  },
  "automergeType": "pr",
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "Minor and patch updates: one grouped PR a day, automerged once CI passes",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all minor and patch dependencies",
      "groupSlug": "all-minor-patch",
      "schedule": ["before 6am"],
      "automerge": true
    }
  ]
}
