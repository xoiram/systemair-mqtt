{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "7 days",
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "github-actions": {
    "pinDigests": true
  },
  "automergeType": "pr",
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "Minor and patch updates automerge once CI passes",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ]
}
